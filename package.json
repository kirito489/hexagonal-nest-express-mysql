{
  "name": "hexagonal-monorepo",
  "version": "0.0.1",
  "description": "Hexagonal NestJS backend + React admin monorepo",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "build": "pnpm --filter @app/api build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "concurrently": "^9.1.0"
  }
}
