{
  "name": "hexagonal-monorepo",
  "version": "0.0.1",
  "description": "Hexagonal NestJS backend + React admin monorepo",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "dev:db": "docker compose -f compose.dev.yml up -d --wait",
    "dev:db:stop": "docker compose -f compose.dev.yml stop",
    "dev:db:reset": "docker compose -f compose.dev.yml down -v",
    "build": "pnpm --filter @app/api build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "verify:ci": "bash scripts/verify-ci.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter @app/api exec eslint --fix",
    "apps/web/**/*.{ts,tsx}": "pnpm --filter @app/web exec eslint --fix"
  }
}
