generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model SystemLogRecord {
  id           String   @id @default(uuid())
  memberId     String?  @map("member_id")
  action       String
  ipAddress    String?  @map("ip_address")
  method       String?
  url          String?
  request      String?  @db.Text
  response     String?  @db.Text
  statusCode   Int?     @map("status_code")
  execTime     Float?   @map("exec_time")
  requestTime  DateTime @map("request_time")
  responseTime DateTime @map("response_time")
  createdAt    DateTime @default(now()) @map("created_at")

  // 保留排程以 createdAt 為條件批次刪除，沒有索引會全表掃描；
  // memberId 複合索引供日後查「某帳號的操作紀錄」
  @@index([createdAt], map: "idx_system_logs_created")
  @@index([memberId, createdAt], map: "idx_system_logs_member_created")
  @@map("system_logs")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(100)
  status      Boolean          @default(true)
  roleCode    String?          @map("role_code") @db.VarChar(50)
  isDefault   Boolean          @default(false) @map("is_default")
  createdBy   String?          @map("created_by") @db.VarChar(36)
  updatedBy   String?          @map("updated_by") @db.VarChar(36)
  members     MemberRecord[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@map("roles")
}

model Permission {
  id             String           @id @default(uuid())
  permissionCode String           @unique @map("permission_code")
  name           String
  platform       String // "FRONTEND" | "BACKEND"
  module         String
  subModule      String?          @map("sub_module")
  action         String // "VIEW" | "EDIT" | "ACCESS"
  status         Boolean          @default(true)
  roles          RolePermission[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ORM Record — 只存在於 adapter/out/persistence 層，與 Domain Member 完全分離
model MemberRecord {
  id                 String    @id @default(uuid())
  member             String    @db.VarChar(100)
  password           String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  roleId             String    @map("role_id")
  role               Role      @relation(fields: [roleId], references: [id])
  status             Boolean   @default(true)
  isDefault          Boolean   @default(false) @map("is_default")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  tokenVersion       Int       @default(0) @map("token_version")
  lockedAt           DateTime? @map("locked_at")
  lastPasswordChange DateTime? @map("last_password_change")
  createdBy          String?   @map("created_by") @db.VarChar(36)
  updatedBy          String?   @map("updated_by") @db.VarChar(36)
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@map("members")
}

/// 前台使用者。**與 members 完全獨立**——members 帶著 roleId / lockedAt /
/// isDefault / failedLoginCount 這些 RBAC 與後台專屬欄位，前台一個都不需要；
/// 反過來前台需要顯示名稱與信箱驗證狀態，後台沒有。
///
/// 共用一張表會讓每一支查詢都要記得帶「這是哪一側」的條件，
/// 而忘記帶的後果是跨側資料外洩。分表之後那個錯誤在型別層就發生不了。
model UserRecord {
  id String @id @default(uuid())

  email    String @unique @db.VarChar(255)
  /// bcrypt hash
  password String @db.VarChar(255)

  /// 對外顯示的名字。**刻意不唯一**——強制唯一會讓註冊體驗變差
  displayName String @map("display_name") @db.VarChar(50)

  /// 信箱驗證完成的時間；null 表示未驗證。
  /// 本階段**只存不判斷**，要不要擋未驗證的帳號由註冊流程決定
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// 啟用狀態。false 時登入直接拒絕
  status Boolean @default(true)

  /// JWT 失效世代。與 members 同樣的機制：登出、改密碼、refresh 重用連坐撤銷時 +1，
  /// 是「立即讓該帳號所有裝置的既發 token 失效」的唯一手段
  tokenVersion Int @default(0) @map("token_version")

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// 軟刪除標記。所有查詢必須帶 deletedAt: null
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

/// 一次性 token 的用途。**用 enum 而非自由字串**：打錯字的後果是
/// 「token 永遠 claim 不到」，而那看起來像 token 失效、不像程式錯誤——
/// 排查方向會被帶偏。
enum UserTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// 前台使用者的一次性 token（信箱驗證與密碼重設共用一張表）。
///
/// 兩種用途在機制上完全相同（一次性、有效期、只存雜湊、原子 claim），
/// 差別只有用途與效期——開兩張表會把同一段邏輯寫兩次。
///
/// ⚠️ **claim 時必須一併比對 purpose**：少了它，拿驗證信的 token 就能重設密碼，
/// 而兩者的取得難度差很多（驗證信在註冊當下就寄出，不需要知道密碼）。
model UserTokenRecord {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// 只存 sha256 雜湊，不存明文——DB 外洩也無法反推出可用的 token
  token   String           @unique
  purpose UserTokenPurpose

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // 供「重發時作廢該使用者其他 token」與過期 token 清理
  @@index([userId, purpose], map: "idx_user_tokens_user_purpose")
  @@index([expiresAt], map: "idx_user_tokens_expires")
  @@map("user_tokens")
}

model AuthLogRecord {
  id        String   @id @default(uuid())
  memberId  String?  @map("member_id")
  email     String
  action    String // LOGIN_SUCCESS | LOGIN_FAILURE | LOGOUT | PASSWORD_RESET | REFRESH
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  // email 複合索引供「某帳號的登入失敗紀錄」這類稽核查詢
  @@index([createdAt], map: "idx_auth_logs_created")
  @@index([email, createdAt], map: "idx_auth_logs_email_created")
  @@index([memberId, createdAt], map: "idx_auth_logs_member_created")
  @@map("auth_logs")
}

model IpWhitelistRecord {
  id          String   @id @default(uuid())
  ipAddress   String   @unique @map("ip_address")
  description String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ip_whitelist")
}

model IpBlacklistRecord {
  id          String   @id @default(uuid())
  ipAddress   String   @unique @map("ip_address")
  reason      String?
  isAutoBlock Boolean  @default(false) @map("is_auto_block")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ip_blacklist")
}

model PasswordResetTokenRecord {
  id        String    @id @default(uuid())
  memberId  String    @map("member_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // 供「重設密碼時作廢該使用者其他 token」與過期 token 清理
  @@index([memberId], map: "idx_password_reset_member")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

model AttachmentRecord {
  id           String   @id @default(uuid())
  /// 檔案名稱（存入前須先做 latin1→UTF-8 轉換）
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileType     String   @map("file_type") @db.VarChar(50)
  fileSize     Int      @map("file_size")
  relatedTable String   @map("related_table") @db.VarChar(50)
  relatedId    String   @map("related_id") @db.VarChar(36)
  uploadedBy   String?  @map("uploaded_by") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([relatedTable, relatedId], map: "idx_related")
  @@index([uploadedBy], map: "idx_uploaded_by")
  @@map("attachments")
}

model SeedHistoryRecord {
  id         Int      @id @default(autoincrement())
  seedName   String   @unique @map("seed_name") @db.VarChar(255)
  executedAt DateTime @default(now()) @map("executed_at")

  @@index([seedName], map: "idx_seed_name")
  @@map("seed_history")
}
