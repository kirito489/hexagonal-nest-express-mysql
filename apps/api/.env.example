NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=hexagonal-nest-express
API_BASE_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hexagonal_express_db
# DATABASE_URL 僅供 Prisma CLI 工具使用（prisma migrate dev / studio）
# 應用程式啟動時由 PrismaService 自動以 DB_* 變數組裝，不需手動設定
# DATABASE_URL=mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# JWT（使用 openssl rand -hex 32 產生隨機 secret）
# node -e "import('crypto').then(c => console.log(c.randomBytes(32).toString('hex')))"
# node -e "import('crypto').then(c => console.log(c.randomBytes(64).toString('hex')))"
ACCESS_SECRET=
ACCESS_TOKEN_EXPIRES_IN=7200  # 秒（= 2 小時）
REFRESH_SECRET=
REFRESH_TOKEN_EXPIRES_IN=604800
SESSION_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nest:
REDIS_TTL=0  # 0 = 不設全域 TTL；blacklist / MemberContext 快取各自傳入 TTL
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookie（使用 openssl rand -hex 32 產生隨機 secret）
COOKIE_SECRET=

# Firebase FCM
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_MEDIA_LIBRARY_ROOT=local

# Email SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NestJS App" <noreply@example.com>

# 權限快取 TTL（秒）
PERMISSION_CACHE_TTL=300

# bcrypt rounds（生產環境建議 ≥ 12）
BCRYPT_ROUNDS=10

# ─── 速率限制 ───
COMMON_RATE_LIMIT_WINDOW_MS=60000
COMMON_RATE_LIMIT_MAX_REQUESTS=100

# ─── 功能開關（Feature Flags） ───
APPLICATION_ADMIN_ROLE_ENABLED=true
APPLICATION_AUTH_LOG_ENABLED=false
APPLICATION_IP_WHITELIST_ENABLED=false
APPLICATION_IP_BLACKLIST_ENABLED=false
APPLICATION_ACCOUNT_LOCK_ENABLED=false
APPLICATION_PASSWORD_CHANGE_ENABLED=false
APPLICATION_SESSION_IDLE_ENABLED=false
APPLICATION_GOOGLE_RECAPTCHA_ENABLED=false
APPLICATION_API_LOG_ENABLED=false
APPLICATION_OPERATION_LOG_ENABLED=false

# ─── 密碼策略 ───
# 複雜度等級：0=僅檢查長度, 1=大小寫+數字, 2=+特殊符號, 3=+禁止常見弱密碼
APPLICATION_PASSWORD_MIN_LENGTH=8
APPLICATION_PASSWORD_MAX_LENGTH=32
APPLICATION_SYSTEM_ADMIN_PASSWORD_COMPLEXITY=4
APPLICATION_OTHER_ADMIN_PASSWORD_COMPLEXITY=1
APPLICATION_PASSWORD_CHANGE_PERIOD=6  # 月
APPLICATION_IS_LOGOUT_AFTER_PASSWORD_RESET=false

# ─── 帳號鎖定 ───
APPLICATION_ACCOUNT_LOCK_THRESHOLD=3
APPLICATION_IP_BLOCK_THRESHOLD=5

# ─── Google reCAPTCHA ───
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
GOOGLE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_VERSION=v2
GOOGLE_RECAPTCHA_IS_PRODUCTION=false

# ─── 閒置自動登出 ───
APPLICATION_SESSION_IDLE_TIMEOUT=120  # 分鐘

# ─── 密碼重設 ───
APP_PASSWORD_RESET_TOKEN_EXPIRES_IN=30  # 分鐘
APP_PASSWORD_RESET_URL=

# ─── Seed 預設帳號 ───
ADMIN_DEFAULT_EMAIL=admin@test.com
ADMIN_DEFAULT_PASSWORD=Admin1234!

# ─── 分頁 ───
DEFAULT_PAGE_LIMIT=10

# ─── 應用時區 ───
APP_TIMEZONE=Asia/Taipei

# ─── 任務通知排程 ───
NOTIFICATION_ALARM_HOUR=8
NOTIFICATION_ALARM_MINUTE=0
