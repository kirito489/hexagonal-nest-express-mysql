# =============================================================================
# repo 根目錄的 .env.example —— **基礎設施設定**（容器對外開哪個埠、開發 DB 密碼）
# -----------------------------------------------------------------------------
# 複製成 `.env` 後即可調整：
#
#   cp .env.example .env
#
# **不複製也能跑**：下面每一行都是 compose 的內建預設值，沒有 `.env` 時
# compose 會用 `${VAR:-預設}` 的後半段。這份存在的目的是讓「有哪些可以調」
# 一眼看得到——否則要調埠的人得去讀 compose.yml。
#
# ── 與 apps/api/.env 的分工 ──
#
#   本檔（根目錄）        compose 展開 `${...}` 時讀 → 「容器對外開哪個埠」
#   apps/api/.env         envSchema 讀 → 「應用程式要連到哪、在哪監聽」
#   apps/api/.env.container  容器模式的個人覆寫（選用，見 compose.yml 的 env_file）
#
# **改埠時兩份要成對改。** 例如 DEV_DB_PORT 改成 3326，
# `apps/api/.env` 的 DB_PORT 也要改成 3326，否則 host 模式的 api 連不到——
# 而錯誤訊息只會說 connection refused，指不到是哪一份沒改。
# =============================================================================

# ─── 對外埠 ───
# 全部綁 127.0.0.1（只給本機，不曝露到區網），且刻意避開 MySQL 3306 /
# Redis 6379 的預設值——多數開發機已經有一組資料庫在跑，佔用預設埠會直接起不來。

# 容器模式的**唯一入口**（nginx）。api 與 web 刻意不發布對外埠；
# 這個值同時決定容器內的 API_BASE_URL / APP_FRONT_URL / APP_PASSWORD_RESET_URL
APP_PROXY_PORT=8080

# **不是對外埠**，是 CORS 的允許來源：host 模式下 vite dev server 的埠。
# 容器模式不經過它（走 nginx 單一入口），改了只影響 `pnpm dev` 的跨來源請求
APP_WEB_PORT=5173

# 開發用 MySQL / Redis（named volume，重啟保留資料）
DEV_DB_PORT=3316
DEV_REDIS_PORT=6389

# ─── 開發資料庫 ───
# 只用於容器內 mysql 服務的初始化。**這不是正式環境的憑證**，
# 正式環境一律由部署平台注入
DEV_DB_DATABASE=hexagonal_express_db
DEV_DB_PASSWORD=devsecret

# 驗證用 MySQL（`--profile verify`，tmpfs、跑完即拋）的埠目前**寫死 13306**，
# 沒有對應的變數。要讓它可調的話 compose.yml 與本檔要一起改
